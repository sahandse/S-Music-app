{
  "name": "high-music-desktop",
  "version": "1.0.0",
  "description": "High Music — Windows desktop client for your Subsonic/Navidrome server",
  "author": "High Music",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"cross-env ELECTRON_DEV=1 electron .\"",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder --win --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "blueimp-md5": "^2.19.0"
  },
  "devDependencies": {
    "@types/blueimp-md5": "^2.18.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "ir.music.high.desktop",
    "productName": "High Music",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
